// =====================================================
//  BOTOES
// =====================================================

Key pollButtons()
{
  unsigned long now = millis();
  for (auto &b : buttons)
  {
    bool raw = (digitalRead(b.pin) == LOW);
    if (raw != b.raw) { b.raw = raw; b.tChange = now; }

    if (now - b.tChange >= 30 && raw != b.stable)
    {
      b.stable = raw;
      if (raw)
      {
        b.tPress = now;
        b.tRep = now;
        return b.key;                                      // dispara ao apertar
      }
    }

    if (b.stable && b.repeat && now - b.tPress > 500 && now - b.tRep > 120)
    {
      b.tRep = now;
      return b.key;                                        // auto-repeticao ao segurar
    }
  }
  return K_NONE;
}

