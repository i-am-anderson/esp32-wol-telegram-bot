String agoStr(unsigned long t)
{
  if (t == 0) return "nunca";
  unsigned long s = (millis() - t) / 1000;
  if (s < 60) return String(s) + "s atras";
  if (s < 3600) return String(s / 60) + "min atras";
  return String(s / 3600) + "h atras";
}

String durStr(unsigned long s)
{
  unsigned long d = s / 86400; s %= 86400;
  unsigned long h = s / 3600;  s %= 3600;
  unsigned long m = s / 60;
  if (d) return String(d) + "d " + String(h) + "h";
  if (h) return String(h) + "h " + String(m) + "m";
  return String(m) + "m " + String(s % 60) + "s";
}

String pcStateStr()
{
  if (pcState == 1) return "ONLINE";
  if (pcState == 0) return "OFFLINE";
  return "desconhecido";
}

