void navOpenRoot()
{
  navDepth = 0;
  navStack[0] = Nav{ &menuMain, 0, 0 };
}

void navPush(const Menu *m)
{
  if (navDepth < 4)
  {
    navDepth++;
    navStack[navDepth] = Nav{ m, 0, 0 };
  }
}

// O menu tem count itens + 1 linha virtual "< Voltar" (indice == count)
void menuClamp(Nav &n)
{
  if (n.cur < n.top) n.top = n.cur;
  if (n.cur >= n.top + MENU_ROWS) n.top = n.cur - MENU_ROWS + 1;
}

String itemValue(const MenuItem &it)
{
  switch (it.type)
  {
    case IT_TOGGLE:  return *it.value ? "SIM" : "NAO";
    case IT_NUMBER:  return String(*it.value) + (it.unit ? it.unit : "");
    case IT_CHOICE:  return it.choices[*it.value];
    case IT_SUBMENU: return ">";
    default:         return "";
  }
}

String menuRowText(const MenuItem &it)
{
  if (it.type == IT_INFO) return it.info();

  String left = it.label;
  String right = itemValue(it);

  int pad = MAX_COLS - (int)left.length() - (int)right.length();
  if (pad < 1) pad = 1;

  String s = left;
  for (int i = 0; i < pad; i++) s += ' ';
  s += right;
  return s;
}

void confirmStart(const String &l1, const String &l2, void (*yes)(), uint8_t ret)
{
  cfmL1 = l1;
  cfmL2 = l2;
  cfmYes = yes;
  cfmFocus = 0;            // comeca em [Nao]
  cfmReturn = ret;
  gotoScreen(SCR_CONFIRM);
}

void menuBack()
{
  if (navDepth > 0) navDepth--;
  else gotoScreen(SCR_HOME);
  uiRedraw();
}

void editStart(const MenuItem &it)
{
  editItem = &it;
  editBackup = *it.value;
  editFocus = 0;
  editing = true;
  gotoScreen(SCR_EDIT);
}

void cancelEdit()
{
  if (editing && editItem)
  {
    *editItem->value = editBackup;
    if (editItem->onChange) editItem->onChange();
  }
  editing = false;
}

void adjustValue(const MenuItem &it, int dir)
{
  bool isChoice = (it.type == IT_CHOICE);
  int lo = isChoice ? 0 : it.minV;
  int hi = isChoice ? it.nChoices - 1 : it.maxV;
  int st = isChoice ? 1 : it.step;

  int v = *it.value + dir * st;
  if (v > hi) v = isChoice ? lo : hi;
  if (v < lo) v = isChoice ? hi : lo;

  *it.value = v;
  if (it.onChange) it.onChange();
}

void activate(const MenuItem &it)
{
  switch (it.type)
  {
    case IT_SUBMENU:
      navPush(it.submenu);
      break;

    case IT_SCREEN:
      gotoScreen(it.screen);
      break;

    case IT_TOGGLE:
      *it.value = !*it.value;
      if (it.onChange) it.onChange();
      saveSettings();
      break;

    case IT_NUMBER:
    case IT_CHOICE:
      editStart(it);
      break;

    case IT_ACTION:
      if (it.confirm == CONF_NONE) it.action();
      else confirmStart(String(it.label) + "?", it.confirmMsg ? it.confirmMsg : "", it.action, SCR_MENU);
      break;

    default:
      break;
  }
}

