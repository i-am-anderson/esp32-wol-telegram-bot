// --- MENU ---
String titleMenu() { return navStack[navDepth].m->title; }

void drawMenu()
{
  Nav &n = navStack[navDepth];
  const Menu *m = n.m;

  for (int r = 0; r < MENU_ROWS; r++)
  {
    int idx = n.top + r;
    if (idx > m->count) break;
    bool sel = (idx == n.cur);

    if (idx == m->count) uiRow(1 + r, navDepth == 0 ? "< Inicio" : "< Voltar", sel);
    else                 uiRow(1 + r, menuRowText(m->items[idx]), sel);
  }

  uiFooter("^v Move    OK=Entrar");
}

void keyMenu(Key k)
{
  Nav &n = navStack[navDepth];
  const Menu *m = n.m;
  uint8_t total = m->count + 1;   // itens + "< Voltar"

  switch (k)
  {
    case K_UP:
      n.cur = (n.cur == 0) ? total - 1 : n.cur - 1;
      menuClamp(n);
      break;
    case K_DOWN:
      n.cur = (n.cur + 1 >= total) ? 0 : n.cur + 1;
      menuClamp(n);
      break;
    case K_OK:
      if (n.cur >= m->count) { menuBack(); return; }
      activate(m->items[n.cur]);
      break;
    default:
      break;
  }
  uiRedraw();
}

// --- EDICAO: valor -> [Salvar] -> [Cancelar] ---
String titleEdit()
{
  if (!editItem || !editItem->label) return "EDITAR";
  String s = editItem->label;
  s.toUpperCase();
  return s;
}

void drawEdit()
{
  if (!editItem) return;
  const MenuItem &it = *editItem;

  // Valor em fonte grande, centralizado. Com foco, fica invertido.
  String v = "< " + itemValue(it) + " >";
  int w = v.length() * 12;
  int x = (SCREEN_W - w) / 2;
  if (x < 0) x = 0;

  display.setTextSize(2);
  if (editFocus == 0)
  {
    display.fillRect(0, 13, SCREEN_W, 18, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
  }
  else
  {
    display.setTextColor(SSD1306_WHITE);
  }
  display.setCursor(x, 14);
  display.print(v);
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  // Faixa de valores
  if (it.type == IT_NUMBER)
    uiRow(4, "Faixa: " + String(it.minV) + " a " + String(it.maxV) + (it.unit ? it.unit : ""), false);
  else
    uiRow(4, "Opcao " + String(*it.value + 1) + " de " + String(it.nChoices), false);

  uiButton(6, 44, "[Salvar]", editFocus == 1);
  uiButton(64, 44, "[Cancelar]", editFocus == 2);

  uiFooter(editFocus == 0 ? "^v Ajusta  OK=Proximo" : "^v Move    OK=Escolhe");
}

void keyEdit(Key k)
{
  if (!editItem) { gotoScreen(SCR_MENU); return; }
  const MenuItem &it = *editItem;

  switch (editFocus)
  {
    case 0:  // valor
      if (k == K_UP)   adjustValue(it, +1);
      if (k == K_DOWN) adjustValue(it, -1);
      if (k == K_OK)   editFocus = 1;
      break;

    case 1:  // [Salvar]
      if (k == K_UP)   editFocus = 0;
      if (k == K_DOWN) editFocus = 2;
      if (k == K_OK)
      {
        editing = false;
        saveSettings();
        gotoScreen(SCR_MENU);
        return;
      }
      break;

    case 2:  // [Cancelar]
      if (k == K_UP)   editFocus = 1;
      if (k == K_DOWN) editFocus = 0;
      if (k == K_OK)
      {
        cancelEdit();
        gotoScreen(SCR_MENU);
        return;
      }
      break;
  }
  uiRedraw();
}

