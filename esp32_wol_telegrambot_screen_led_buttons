const uint8_t HARD_IDLE_LEVEL = (HARD_WOL_ACTIVE_LEVEL == HIGH) ? LOW : HIGH;

void sendWolSoft()
{
  oledLog("Enviando Magic Packet");
  ledInfoShow(C_BLUE);
  WOL.sendMagicPacket(MAC_ADDR);
  delay(300);
  ledInfoFlash(C_BLUE, 3);
  ledInfoHold(C_BLUE, 2000);
}

void sendWolHard()
{
  oledLog("Acionando Hard WoL");
  ledInfoShow(C_ORANGE);
  digitalWrite(HARD_WOL_PIN, HARD_WOL_ACTIVE_LEVEL);
  delay(cfg.hardPulse);
  digitalWrite(HARD_WOL_PIN, HARD_IDLE_LEVEL);
  ledInfoFlash(C_ORANGE, 3);
  ledInfoHold(C_ORANGE, 2000);
}

// Faz o ping, atualiza estado e LED. Nao escreve no log (quem chama decide).
bool pingPc()
{
  ledInfoShow(C_CYAN);
  bool ok = Ping.ping(PC_IP, 3);
  pcState = ok ? 1 : 0;
  lastPingTime = millis();
  ledInfoHold(ok ? C_GREEN : C_RED, 5000);
  return ok;
}

