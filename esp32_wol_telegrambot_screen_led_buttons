void applyOled()
{
  if (!oledOk) return;
  display.ssd1306_command(SSD1306_SETCONTRAST);
  display.ssd1306_command((uint8_t)cfg.oledContrast);
}

void onOledChange() { applyOled(); }

void oledSleep()
{
  if (!oledOk || !displayAwake) return;
  display.ssd1306_command(SSD1306_DISPLAYOFF);
  displayAwake = false;
}

void oledWake()
{
  lastActivity = millis();
  if (!oledOk || displayAwake) return;
  display.ssd1306_command(SSD1306_DISPLAYON);
  displayAwake = true;
}

// Remove acentos/emojis (a fonte padrao so tem ASCII)
String toAscii(const String &s)
{
  String out;
  for (unsigned int i = 0; i < s.length(); i++)
  {
    if ((uint8_t)s[i] < 128) out += s[i];
  }
  out.trim();
  return out;
}

// Escreve uma linha de texto (row 0..7). inv = true -> faixa branca, texto preto
void uiRow(int row, const String &t, bool inv)
{
  int y = row * 8;
  String s = t.substring(0, MAX_COLS);
  if (inv)
  {
    display.fillRect(0, y, SCREEN_W, 8, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setCursor(1, y);
  }
  else
  {
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(0, y);
  }
  display.print(s);
  display.setTextColor(SSD1306_WHITE);
}

void uiFooter(const char *s)
{
  uiRow(7, String(s), false);
}

// Botao na tela, ex.: "[Salvar]". Com foco, fica em video invertido.
void uiButton(int x, int y, const char *t, bool focused)
{
  int w = strlen(t) * 6;
  if (focused)
  {
    display.fillRect(x - 2, y - 1, w + 4, 10, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
  }
  else
  {
    display.setTextColor(SSD1306_WHITE);
  }
  display.setCursor(x, y);
  display.print(t);
  display.setTextColor(SSD1306_WHITE);
}

// Aviso de uma linha por cima da tela atual (nao aparece na tela inicial, que ja e o log)
void uiNotice(const String &msg)
{
  noticeText = msg;
  noticeActive = true;
  noticeUntil = millis() + 2500;
}

// Log: guarda nas linhas da tela inicial e no Serial
void oledLog(String msg)
{
  msg = toAscii(msg);
  if (msg.length() == 0) return;
  Serial.println(msg);
  oledWake();

  String note = msg;
  while (msg.length() > 0)
  {
    String part = msg.substring(0, MAX_COLS);
    msg = msg.substring(part.length());
    for (int i = 0; i < MAX_LINES - 1; i++) logLines[i] = logLines[i + 1];
    logLines[MAX_LINES - 1] = part;
  }

  if (curScreen != SCR_HOME) uiNotice(note);
  uiRedraw();
}

